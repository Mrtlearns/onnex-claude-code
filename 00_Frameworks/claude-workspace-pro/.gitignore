# Session state — ephemeral, not committed
.claude/state/current-work.json
.claude/state/sessions/

# Outputs — generated artifacts, commit selectively
outputs/

# Logs
*.log

# Local overrides
.env
.env.*
*.local

# rclone config — contains OAuth tokens, never commit
files/*.conf
files/rclone*.conf

# Terminal Paste Image folder
.cp-images/
