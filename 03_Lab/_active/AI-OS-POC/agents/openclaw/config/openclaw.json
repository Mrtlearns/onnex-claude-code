// OpenClaw gateway configuration for Agency AI-OS POC
// Phase 3 deployment — Docker container on app_net
{
  // Gateway bind to all interfaces so aios-api + other app_net containers can reach it
  // Default is "loopback" (127.0.0.1 only) — Docker bridge networking requires "lan"
  gateway: {
    bind: "lan",
    port: 18789,
    auth: {
      // Token read from OPENCLAW_GATEWAY_TOKEN env var at runtime (SecretRef inactive when env var set)
      mode: "token",
    },
  },

  // Agents workspace config
  agents: {
    defaults: {
      workspace: "/workspace",
    },
  },

  // Logging
  logging: {
    level: "info",
  },
}
