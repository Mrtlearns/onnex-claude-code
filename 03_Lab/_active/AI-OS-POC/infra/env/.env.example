# ============================================================
# Agency AI-OS — Environment Variables
# Copy this file to infra/env/.env and fill in values.
# NEVER commit infra/env/.env
# ============================================================

# --- Global ---
APP_ENV=
APP_DOMAIN=
TZ=
LOG_LEVEL=

# --- Traefik ---
TRAEFIK_ENTRYPOINT_WEB=
TRAEFIK_ENTRYPOINT_WEBSECURE=
TRAEFIK_ACME_EMAIL=

# --- Postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Redis ---
# (no extra vars — uses defaults)

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BROWSER_REDIRECT_URL=

# --- Authentik ---
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRESQL__HOST=
AUTHENTIK_POSTGRESQL__NAME=
AUTHENTIK_POSTGRESQL__USER=
AUTHENTIK_POSTGRESQL__PASSWORD=
AUTHENTIK_REDIS__HOST=

# --- Temporal ---
TEMPORAL_UI_PORT=
TEMPORAL_DB_HOST=
TEMPORAL_DB_NAME=
TEMPORAL_DB_USER=
TEMPORAL_DB_PASSWORD=

# --- AI-OS Backend ---
API_PORT=
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=
S3_BUCKET_ARTIFACTS=
OPENCLAW_BASE_URL=
NEXTCLOUD_BASE_URL=
NEXTCLOUD_APP_PASSWORD=
PAPERLESS_BASE_URL=
PAPERLESS_TOKEN=
PAPERLESS_AI_BASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=

# --- AI Provider (Gemini via OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
# Override chat model — defaults to gemini-2.5-pro-preview
GEMINI_CHAT_MODEL=

# --- Auth (Next-Auth / Authentik) ---
PUBLIC_DOMAIN=
AUTH_URL=
AUTH_SECRET=
AUTH_AUTHENTIK_ISSUER=
AUTH_AUTHENTIK_PUBLIC_URL=
AUTH_AUTHENTIK_ID=
AUTH_AUTHENTIK_SECRET=

# --- Frontend ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_AUTH_URL=

# --- OpenClaw ---
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_PROFILE=
OPENCLAW_WORKSPACE=
OPENCLAW_CONFIG_PATH=

# --- Nextcloud ---
NEXTCLOUD_TRUSTED_DOMAINS=

# --- Paperless ---
PAPERLESS_REDIS=
PAPERLESS_DBHOST=
PAPERLESS_DBNAME=
PAPERLESS_DBUSER=
PAPERLESS_DBPASS=
PAPERLESS_URL=
PAPERLESS_OCR_LANGUAGE=

# --- Paperless-AI ---
OLLAMA_BASE_URL=
