# PI Lawyer OS — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Application ──────────────────────────────────────────────
APP_DOMAIN=pilaweros.local          # e.g. app.smithinjurylaw.com

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=pilaweros
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── PostgREST / Auth JWT ──────────────────────────────────────
# Must be same secret in both PostgREST and auth service
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string

# ── n8n ──────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_n8n_password

# ── Twilio ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+17025550000    # firm's Twilio phone number

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# ── Internal PostgREST notification webhook URL ───────────────
# n8n webhook URL for speed-to-lead trigger
N8N_LEAD_WEBHOOK_URL=https://pilaweros.local/n8n/webhook/lead-created

# ── AI / LLM ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...    # used by OpenClaw (Wyatt agent)

# ── Internal notification (Slack/Teams/etc) ──────────────────
# Optional: notify intake team when new lead arrives
INTERNAL_NOTIFY_WEBHOOK=
