{
  "name": "PI Lawyer OS — Lead Scoring",
  "active": true,
  "nodes": [
    {
      "id": "node-score-schedule",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "node-score-fetch-unscored",
      "name": "Fetch Unscored Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "http://postgrest:3000/leads?lead_score=is.null&select=id,firm_id,first_name,last_name&limit=20",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.PGRST_SERVICE_KEY }}" },
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-score-split",
      "name": "Split Into Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-score-call-ai",
      "name": "Score Lead via AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "parameters": {
        "method": "POST",
        "url": "http://ai:8002/score-lead",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY ?? 'pilaweros_internal_key_changeme' }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "={ \"lead_id\": \"{{ $('Split Into Leads').item.json.id }}\" }",
        "rawContentType": "application/json",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Fetch Unscored Leads", "type": "main", "index": 0 }]]
    },
    "Fetch Unscored Leads": {
      "main": [[{ "node": "Split Into Leads", "type": "main", "index": 0 }]]
    },
    "Split Into Leads": {
      "main": [
        [],
        [{ "node": "Score Lead via AI", "type": "main", "index": 0 }]
      ]
    },
    "Score Lead via AI": {
      "main": [[{ "node": "Split Into Leads", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "name": "pi-lawyer-os" }]
}
