{
  "name": "PI OS \u2014 Retainer Follow-Up",
  "active": true,
  "nodes": [
    {
      "id": "node-schedule-daily-9am",
      "name": "Daily 9am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        400
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "node-http-get-contacted-leads",
      "name": "Fetch Contacted Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "=http://postgrest:3000/leads?status=eq.contacted&updated_at=lt.{{ DateTime.now().minus({hours: 48}).toISO() }}&reminder_count=lt.10&select=id,firm_id,first_name,phone,reminder_count,updated_at",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PGRST_SERVICE_KEY }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-split-batches-retainer",
      "name": "Split Into Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        680,
        400
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-set-days-since",
      "name": "Calculate Days Since Contact",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        400
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-lead-id",
              "name": "lead_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "assign-firm-id",
              "name": "firm_id",
              "value": "={{ $json.firm_id }}",
              "type": "string"
            },
            {
              "id": "assign-first-name",
              "name": "first_name",
              "value": "={{ $json.first_name }}",
              "type": "string"
            },
            {
              "id": "assign-phone",
              "name": "phone",
              "value": "={{ $json.phone }}",
              "type": "string"
            },
            {
              "id": "assign-reminder-count",
              "name": "reminder_count",
              "value": "={{ $json.reminder_count }}",
              "type": "number"
            },
            {
              "id": "assign-days-since",
              "name": "days_since_contact",
              "value": "={{ Math.floor((DateTime.now().toMillis() - DateTime.fromISO($json.updated_at).toMillis()) / 86400000) }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-switch-days",
      "name": "Switch on Days Since Contact",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "mode": "rules",
        "options": {},
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-2day",
                    "leftValue": "={{ $json.days_since_contact }}",
                    "rightValue": 2,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  },
                  {
                    "id": "cond-2day-lt5",
                    "leftValue": "={{ $json.days_since_contact }}",
                    "rightValue": 5,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "2-day"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-5day",
                    "leftValue": "={{ $json.days_since_contact }}",
                    "rightValue": 5,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  },
                  {
                    "id": "cond-5day-lt10",
                    "leftValue": "={{ $json.days_since_contact }}",
                    "rightValue": 10,
                    "operator": {
                      "type": "number",
                      "operation": "lt"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "5-day"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "cond-10day",
                    "leftValue": "={{ $json.days_since_contact }}",
                    "rightValue": 10,
                    "operator": {
                      "type": "number",
                      "operation": "gte"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "10-day"
            }
          ]
        }
      }
    },
