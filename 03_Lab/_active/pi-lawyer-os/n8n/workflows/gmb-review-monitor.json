{
  "id": "a1000009-0000-0000-0000-000000000009",
  "name": "PI OS — GMB Review Monitor",
  "active": true,
  "nodes": [
    {
      "id": "node-gmb-schedule",
      "name": "Daily at 8am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "node-gmb-stub-check",
      "name": "SerpAPI Key Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-serpapi",
              "leftValue": "={{ $env.SERPAPI_KEY ?? 'stub' }}",
              "rightValue": "stub",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-gmb-serpapi",
      "name": "Fetch Reviews via SerpAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200],
      "parameters": {
        "method": "GET",
        "url": "https://serpapi.com/search.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "engine", "value": "google_maps_reviews" },
            { "name": "place_id", "value": "={{ $env.GMB_PLACE_ID ?? '' }}" },
            { "name": "api_key", "value": "={{ $env.SERPAPI_KEY }}" },
            { "name": "sort_by", "value": "newestFirst" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-gmb-stub-reviews",
      "name": "Stub: One Fake Review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 400],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "assign-stub-reviews",
              "name": "reviews",
              "value": "=[{\"rating\": 5, \"date\": \"a day ago\", \"user\": {\"name\": \"John Doe (Stub)\"}, \"snippet\": \"Excellent firm — highly recommend for any injury case.\"}]",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-gmb-merge",
      "name": "Normalise Reviews",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "// Normalise reviews from either SerpAPI or stub\nconst items = $input.all();\nlet reviews = [];\n\nfor (const item of items) {\n  // SerpAPI response has reviews array\n  if (item.json.reviews) {\n    reviews = item.json.reviews;\n  }\n  // Stub has a JSON string in 'reviews'\n  if (item.json.reviews && typeof item.json.reviews === 'string') {\n    try { reviews = JSON.parse(item.json.reviews); } catch(e) { reviews = []; }\n  }\n}\n\n// Filter: 4-5 stars only\nreviews = reviews.filter(r => (r.rating ?? 0) >= 4);\n\n// Map to standard shape\nreturn reviews.map(r => ({\n  json: {\n    reviewer_name: r.user?.name ?? 'Unknown',\n    rating: r.rating,\n    notes: r.snippet ?? '',\n    date: r.date ?? ''\n  }\n}));"
      }
    },
    {
      "id": "node-gmb-split",
      "name": "Split Reviews",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "node-gmb-check-dup",
      "name": "Check for Duplicate Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 200],
      "parameters": {
        "method": "GET",
        "url": "=http://postgrest:3000/leads?source=eq.review&notes=like.*{{ encodeURIComponent($('Split Reviews').item.json.reviewer_name) }}*&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.PGRST_SERVICE_KEY }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-gmb-is-new",
      "name": "New Reviewer?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-new",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-gmb-create-lead",
      "name": "Create Lead from Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 100],
      "parameters": {
        "method": "POST",
        "url": "http://postgrest:3000/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.PGRST_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "={{ JSON.stringify({ source: 'review', status: 'new', first_name: $('Split Reviews').item.json.reviewer_name.split(' ')[0] ?? 'Google', last_name: $('Split Reviews').item.json.reviewer_name.split(' ').slice(1).join(' ') || 'Reviewer', notes: 'From Google Review (★' + $('Split Reviews').item.json.rating + '): ' + $('Split Reviews').item.json.notes }) }}",
        "rawContentType": "application/json",
        "options": {}
      }
    },
    {
      "id": "node-gmb-loop-back",
      "name": "Next Review",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1780, 300],
      "parameters": {}
    }
  ],
  "connections": {
    "Daily at 8am": {
      "main": [[{ "node": "SerpAPI Key Available?", "type": "main", "index": 0 }]]
    },
    "SerpAPI Key Available?": {
      "main": [
        [{ "node": "Fetch Reviews via SerpAPI", "type": "main", "index": 0 }],
        [{ "node": "Stub: One Fake Review", "type": "main", "index": 0 }]
      ]
    },
    "Fetch Reviews via SerpAPI": {
      "main": [[{ "node": "Normalise Reviews", "type": "main", "index": 0 }]]
    },
    "Stub: One Fake Review": {
      "main": [[{ "node": "Normalise Reviews", "type": "main", "index": 0 }]]
    },
    "Normalise Reviews": {
      "main": [[{ "node": "Split Reviews", "type": "main", "index": 0 }]]
    },
    "Split Reviews": {
      "main": [
        [],
        [{ "node": "Check for Duplicate Lead", "type": "main", "index": 0 }]
      ]
    },
    "Check for Duplicate Lead": {
      "main": [[{ "node": "New Reviewer?", "type": "main", "index": 0 }]]
    },
    "New Reviewer?": {
      "main": [
        [{ "node": "Create Lead from Review", "type": "main", "index": 0 }],
        [{ "node": "Next Review", "type": "main", "index": 0 }]
      ]
    },
    "Create Lead from Review": {
      "main": [[{ "node": "Split Reviews", "type": "main", "index": 0 }]]
    },
    "Next Review": {
      "main": [[{ "node": "Split Reviews", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "tags": [{ "name": "pi-lawyer-os" }]
}
