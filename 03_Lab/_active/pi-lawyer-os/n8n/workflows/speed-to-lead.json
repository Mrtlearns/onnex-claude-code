{
  "name": "PI OS \u2014 Speed to Lead",
  "active": true,
  "nodes": [
    {
      "id": "node-webhook-trigger",
      "name": "Lead Created Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "3abfb5c7-a3db-4a05-a586-187a7bf28048"
    },
    {
      "id": "node-set-extract",
      "name": "Extract Lead Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-id",
              "name": "lead_id",
              "value": "={{ $json.body.id }}",
              "type": "string"
            },
            {
              "id": "assign-firm-id",
              "name": "firm_id",
              "value": "={{ $json.body.firm_id }}",
              "type": "string"
            },
            {
              "id": "assign-first-name",
              "name": "first_name",
              "value": "={{ $json.body.first_name }}",
              "type": "string"
            },
            {
              "id": "assign-phone",
              "name": "phone",
              "value": "={{ $json.body.phone }}",
              "type": "string"
            },
            {
              "id": "assign-injury-type",
              "name": "injury_type",
              "value": "={{ $json.body.injury_type ?? 'injury' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "node-if-test-mode",
      "name": "Test Mode?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-test-mode",
              "leftValue": "={{ $env.TWILIO_TEST_MODE }}",
              "rightValue": "true",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-http-stub-sms",
      "name": "Stub Log SMS (Test Mode)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        160
      ],
      "parameters": {
        "method": "POST",
        "url": "http://postgrest:3000/communications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PGRST_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "={\n  \"lead_id\": \"{{ $('Extract Lead Fields').item.json.lead_id }}\",\n  \"firm_id\": \"{{ $('Extract Lead Fields').item.json.firm_id }}\",\n  \"channel\": \"sms\",\n  \"direction\": \"outbound\",\n  \"message\": \"[TEST] Hi {{ $('Extract Lead Fields').item.json.first_name }}, we received your inquiry about your {{ $('Extract Lead Fields').item.json.injury_type }} case. An attorney will call you within 15 minutes.\",\n  \"status\": \"stub\"\n}",
        "options": {},
        "rawContentType": "application/json"
      }
    },
    {
      "id": "node-twilio-sms",
      "name": "Send Speed-to-Lead SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        900,
        440
      ],
      "parameters": {
        "operation": "send",
        "from": "={{ $env.TWILIO_FROM_NUMBER }}",
        "to": "={{ $('Extract Lead Fields').item.json.phone }}",
        "message": "=Hi {{ $('Extract Lead Fields').item.json.first_name }}, we received your inquiry about your {{ $('Extract Lead Fields').item.json.injury_type }} case. An attorney will call you within 15 minutes. \u2014 Our team",
        "options": {}
      },
      "credentials": {
        "twilioApi": {
          "id": "twilio-account-cred",
          "name": "Twilio Account"
        }
      }
    },
    {
      "id": "node-http-log-comm",
      "name": "Log Communication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        440
      ],
      "parameters": {
        "method": "POST",
        "url": "http://postgrest:3000/communications",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PGRST_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "={\n  \"lead_id\": \"{{ $('Extract Lead Fields').item.json.lead_id }}\",\n  \"firm_id\": \"{{ $('Extract Lead Fields').item.json.firm_id }}\",\n  \"channel\": \"sms\",\n  \"direction\": \"outbound\",\n  \"message\": \"Speed-to-lead SMS sent\",\n  \"status\": \"sent\"\n}",
        "options": {},
        "rawContentType": "application/json"
      }
    },
    {
      "id": "node-if-internal-notify",
      "name": "Internal Notify Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-notify-webhook",
              "leftValue": "={{ $env.INTERNAL_NOTIFY_WEBHOOK }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "node-http-internal-notify",
      "name": "Send Internal Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTERNAL_NOTIFY_WEBHOOK }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "body": "={\n  \"text\": \"\ud83d\udd14 New lead: {{ $('Extract Lead Fields').item.json.first_name }} ({{ $('Extract Lead Fields').item.json.phone }}) \u2014 SMS sent\"\n}",
        "options": {},
        "rawContentType": "application/json"
      }
    }
  ],
  "connections": {
