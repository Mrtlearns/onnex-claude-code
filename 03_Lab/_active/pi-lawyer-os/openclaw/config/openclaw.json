// OpenClaw gateway configuration — PI Lawyer OS
// Wyatt: AI assistant for PI law firm operations
{
  gateway: {
    bind: "lan",
    port: 47823,
    auth: {
      // Token read from OPENCLAW_GATEWAY_TOKEN env var at runtime
      mode: "token",
    },
    controlUi: {
      // Allow the PI Lawyer OS frontend to embed the canvas in an iframe
      allowedOrigins: ["*"],
      // Required for HTTP (non-localhost) deployments — disable for production HTTPS
      allowInsecureAuth: true,
      dangerouslyDisableDeviceAuth: true,
    },
  },

  agents: {
    defaults: {
      workspace: "/workspace",
      model: {
        primary: "openrouter/auto",
        fallbacks: ["anthropic/claude-sonnet-4-6"],
      },
      thinkingDefault: "low",
      timeoutSeconds: 600,
    },

    list: [
      {
        id: "wyatt",
        default: true,
        name: "Wyatt",
        workspace: "/workspace",
        model: {
          primary: "openrouter/auto",
          fallbacks: ["anthropic/claude-sonnet-4-6"],
        },
        identity: {
          name: "Wyatt",
          theme: "sharp PI law firm operations assistant",
          emoji: "⚖️",
        },
      },
    ],
  },

  // MCP tool servers available to all agents
  mcpServers: {
    postgrest: {
      command: "node",
      args: ["/workspace/tools/postgrest-mcp.js"],
      env: {
        // Inherited from container env: JWT_SECRET, PILAWEROS_API_URL
      },
    },
  },

  logging: {
    level: "info",
  },
}
