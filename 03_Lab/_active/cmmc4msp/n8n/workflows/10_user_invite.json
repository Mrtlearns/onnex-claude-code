{
  "id": "a1b2c3d4-0010-0010-0010-000000000000",
  "name": "10 \u2014 User Invite",
  "nodes": [
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "user-invite",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000002",
      "name": "Build Invite Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "functionCode": "const body = $input.first().json.body;\nconst appUrl = process.env.APP_URL || 'https://app.cmmc4msp.on-nex.us';\nconst inviteUrl = `${appUrl}/invite/${body.invite_token}`;\n\nconst roleLabel = { contributor: 'Contributor', viewer: 'Viewer', client_admin: 'Admin' }[body.role] || body.role;\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"><title>CMMC Compliance OS Invitation</title></head>\n<body style=\"font-family: Arial, sans-serif; background: #f9fafb; margin: 0; padding: 20px;\">\n  <div style=\"max-width: 560px; margin: 0 auto; background: #fff; border-radius: 8px; border: 1px solid #e5e7eb; overflow: hidden;\">\n    <div style=\"background: #1d4ed8; padding: 24px 32px;\">\n      <h1 style=\"color: #fff; margin: 0; font-size: 18px;\">CMMC Compliance OS</h1>\n    </div>\n    <div style=\"padding: 32px;\">\n      <h2 style=\"margin: 0 0 16px; color: #111827; font-size: 20px;\">You've been invited</h2>\n      <p style=\"color: #374151; margin: 0 0 12px;\">${body.invited_by_name} has invited you to join <strong>${body.org_name}</strong> on CMMC Compliance OS as a <strong>${roleLabel}</strong>.</p>\n      <p style=\"color: #374151; margin: 0 0 24px;\">This invitation expires in 72 hours.</p>\n      <a href=\"${inviteUrl}\" style=\"display: inline-block; background: #1d4ed8; color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 6px; font-weight: 600;\">Accept Invitation</a>\n      <p style=\"color: #9ca3af; font-size: 12px; margin: 24px 0 0;\">Or copy this link: ${inviteUrl}</p>\n    </div>\n    <div style=\"background: #f9fafb; border-top: 1px solid #e5e7eb; padding: 16px 32px;\">\n      <p style=\"color: #9ca3af; font-size: 11px; margin: 0;\">You received this email because someone invited you to CMMC Compliance OS. If this was a mistake, you can ignore this email.</p>\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn [{\n  json: {\n    email: body.email,\n    invite_token: body.invite_token,\n    org_name: body.org_name,\n    invited_by_name: body.invited_by_name,\n    role: body.role,\n    invite_url: inviteUrl,\n    html,\n    subject: `${body.org_name} has invited you to CMMC Compliance OS`,\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000005",
      "name": "Send via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ from: 'no-reply@cmmc4msp.on-nex.us', to: $json.email, subject: $json.subject, html: $json.html }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "resend-api",
          "name": "Resend API"
        }
      }
    },
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000003",
      "name": "Log to email_log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO email_log (recipient_email, category, subject, provider_id) VALUES ('{{ $('Build Invite Data').first().json.email }}', 'invite', '{{ $('Build Invite Data').first().json.subject }}', '{{ $json.id }}')",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": {
          "id": "wbmu564j5qFXXA1l",
          "name": "CMMC4MSP Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0010-0010-0010-000000000004",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, email: $('Build Invite Data').first().json.email }) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Build Invite Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Invite Data": {
      "main": [
        [
          {
            "node": "Send via Resend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send via Resend": {
      "main": [
        [
          {
            "node": "Log to email_log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log to email_log": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "a1b2c3d4-0016-0016-0016-000000000000"
  },
  "staticData": null,
  "pinData": null
}