{
  "name": "04 \u00e2\u20ac\u201d Phase Unlock Check",
  "nodes": [
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "phase-unlock-check",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000002",
      "name": "Get Current Phase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT current_phase FROM programs WHERE id = $1::uuid",
        "additionalFields": {
          "queryParams": "={{ $json.program_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000003",
      "name": "Count Incomplete Controls",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as incomplete FROM program_controls pc JOIN control_definitions cd ON pc.control_definition_id = cd.id WHERE pc.program_id = $1::uuid AND cd.far_above_phase = $2 AND pc.is_applicable = true AND pc.status != 'fully_implemented' AND cd.is_objective = false",
        "additionalFields": {
          "queryParams": "={{ $('Webhook').first().json.program_id }},={{ $json.current_phase }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Phase Complete Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ Number($json.incomplete) }}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000005",
      "name": "Calculate Next Phase",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        1050,
        180
      ],
      "parameters": {
        "jsCode": "const current_phase = parseInt($('Get Current Phase').first().json.current_phase);\nconst next_phase = current_phase + 1;\nconst program_id = $('Webhook').first().json.program_id;\n\nif (next_phase > 5) {\n  return [{ json: { can_unlock: false, current_phase, next_phase, program_id, reason: 'Already at final phase' } }];\n}\n\nreturn [{ json: { can_unlock: true, current_phase, next_phase: String(next_phase), program_id } }];"
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000006",
      "name": "Check Can Unlock",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        180
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.can_unlock }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000007",
      "name": "Unlock Next Phase Controls",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1450,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE program_controls SET is_phase_unlocked = true WHERE program_id = $1::uuid AND control_definition_id IN (SELECT id FROM control_definitions WHERE far_above_phase = $2)",
        "additionalFields": {
          "queryParams": "={{ $json.program_id }},={{ $json.next_phase }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000008",
      "name": "Advance Program Phase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1650,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE programs SET current_phase = $1, updated_at = NOW() WHERE id = $2::uuid AND current_phase = $3",
        "additionalFields": {
          "queryParams": "={{ $('Calculate Next Phase').first().json.next_phase }},={{ $('Calculate Next Phase').first().json.program_id }},={{ String($('Calculate Next Phase').first().json.current_phase) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000009",
      "name": "Log Phase Unlock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1850,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (program_id, event_type, description, metadata) VALUES ($1::uuid, 'phase_unlocked', $2, $3::jsonb)",
        "additionalFields": {
          "queryParams": "={{ $('Calculate Next Phase').first().json.program_id }},={{ 'Phase ' + $('Calculate Next Phase').first().json.next_phase + ' unlocked' }},={{ JSON.stringify({ phase: $('Calculate Next Phase').first().json.next_phase }) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000010",
      "name": "Respond Phase Unlocked",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2050,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ phase_unlocked: $('Calculate Next Phase').first().json.next_phase, program_id: $('Calculate Next Phase').first().json.program_id }) }}"
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000011",
      "name": "Respond No Change",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        480
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ no_change: true, program_id: $('Webhook').first().json.program_id, reason: 'Phase not yet complete' }) }}"
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000012",
      "name": "Respond Final Phase",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1450,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ no_change: true, program_id: $json.program_id, reason: $json.reason }) }}"
      }
    }
  ],
