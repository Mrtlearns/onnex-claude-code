      "name": "Fetch Control Definitions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, nist_id, far_above_phase, far_above_sort_order, is_objective FROM control_definitions ORDER BY far_above_phase, far_above_sort_order",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000003",
      "name": "Build Insert Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "parameters": {
        "jsCode": "const payload = $('Webhook').first().json;\nconst program_id = payload.program_id;\nconst org_id = payload.org_id;\nconst na_controls = (payload.scoping_config && payload.scoping_config.na_controls) ? payload.scoping_config.na_controls : [];\n\nconst controlDefs = $input.all().map(i => i.json);\n\nconst rows = controlDefs.map(cd => {\n  const is_applicable = !na_controls.includes(cd.nist_id);\n  const is_phase_unlocked = cd.far_above_phase === '1' || cd.far_above_phase === 1;\n  return {\n    program_id,\n    control_definition_id: cd.id,\n    status: 'not_yet_assessed',\n    is_applicable,\n    is_phase_unlocked,\n    score_impact: 0\n  };\n});\n\nreturn [{\n  json: {\n    rows,\n    program_id,\n    org_id,\n    controls_count: rows.length\n  }\n}];"
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000004",
      "name": "Insert Program Controls",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO program_controls (program_id, control_definition_id, status, is_applicable, is_phase_unlocked)\nSELECT\n  (v->>'program_id')::uuid,\n  (v->>'control_definition_id')::uuid,\n  v->>'status',\n  (v->>'is_applicable')::boolean,\n  (v->>'is_phase_unlocked')::boolean\nFROM jsonb_array_elements($1::jsonb) AS v\nON CONFLICT (program_id, control_definition_id) DO NOTHING",
        "additionalFields": {
          "queryParams": "={{ JSON.stringify($json.rows) }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000005",
      "name": "Update Program Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE programs SET status='in_progress', current_phase='1', updated_at=NOW() WHERE id=$1",
        "additionalFields": {
          "queryParams": "={{ $json.program_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000006",
      "name": "Log Activity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (org_id, program_id, event_type, description, metadata) VALUES ($1::uuid, $2::uuid, 'onboard_complete', 'Client onboarded â€” 110 controls seeded', '{}'::jsonb)",
        "additionalFields": {
          "queryParams": "={{ $('Build Insert Rows').first().json.org_id }},={{ $('Build Insert Rows').first().json.program_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "CMMC Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000007",
