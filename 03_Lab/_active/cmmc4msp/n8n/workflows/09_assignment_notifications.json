{
  "id": "a1b2c3d4-0009-0009-0009-000000000000",
  "name": "09 \u2014 Assignment Notifications",
  "nodes": [
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "assignment-status-changed",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000002",
      "name": "Fetch Assignment Detail",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.status, a.due_date, a.instructions, a.program_id, p.name AS program_name, o.name AS org_name, cd.nist_id, cd.cmmc_id, cd.requirement_text, assignee.email AS assignee_email, assignee.full_name AS assignee_name, assigner.full_name AS assigner_name FROM assignments a JOIN programs p ON a.program_id = p.id JOIN orgs o ON p.org_id = o.id JOIN program_controls pc ON a.program_control_id = pc.id JOIN control_definitions cd ON pc.control_definition_id = cd.id LEFT JOIN users assignee ON a.assigned_to = assignee.id LEFT JOIN users assigner ON a.assigned_by = assigner.id WHERE a.id = '{{ $json.body.assignment_id }}'",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": {
          "id": "wbmu564j5qFXXA1l",
          "name": "CMMC4MSP Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000003",
      "name": "Has Assignee Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.assignee_email }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000004",
      "name": "Log Notification Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO activity_log (org_id, program_id, actor_id, event_type, event_data) SELECT p.org_id, a.program_id, a.assigned_by, 'assignment_notification', jsonb_build_object('assignment_id', a.id, 'to_status', '{{ $('Webhook').first().json.body.to_status }}', 'assignee_email', '{{ $('Fetch Assignment Detail').first().json.assignee_email }}', 'control_nist_id', '{{ $('Fetch Assignment Detail').first().json.nist_id }}') FROM assignments a JOIN programs p ON a.program_id = p.id WHERE a.id = '{{ $('Webhook').first().json.body.assignment_id }}'",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": {
          "id": "wbmu564j5qFXXA1l",
          "name": "CMMC4MSP Postgres"
        }
      }
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000005",
      "name": "Skip \u2014 No Email",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        850,
        400
      ],
      "parameters": {}
    },
    {
      "id": "a1b2c3d4-0009-0009-0009-000000000006",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, assignment_id: $('Webhook').first().json.body.assignment_id, to_status: $('Webhook').first().json.body.to_status }) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Fetch Assignment Detail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Assignment Detail": {
      "main": [
        [
          {
            "node": "Has Assignee Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Assignee Email": {
      "main": [
        [
          {
            "node": "Log Notification Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip \u2014 No Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Notification Event": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Skip \u2014 No Email": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "a1b2c3d4-0016-0016-0016-000000000000"
  },
  "staticData": null,
  "pinData": null
}