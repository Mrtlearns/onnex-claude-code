{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/cost-tracker.py\""
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/pre-compact.py\""
          }
        ],
        "matcher": ""
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "padding": 0,
    "command": "bash \".claude/statusline.sh\""
  }
}
