# AI-Sentinel environment variables
# Copy to infra/env.local and populate secrets — DO NOT commit secrets

AI_SENTINEL_HOST=0.0.0.0
AI_SENTINEL_PORT=8080
AI_SENTINEL_LOG_LEVEL=info

# Auth — set these in production
# AI_SENTINEL_JWT_SECRET=
# AI_SENTINEL_API_KEYS=sha256hash1,sha256hash2
# AI_SENTINEL_ADMIN_TOKEN=
# AI_SENTINEL_TRUST_SECRET=

# Session store
AI_SENTINEL_STORE_BACKEND=memory
# AI_SENTINEL_DATABASE_URL=postgresql://sentinel:password@postgres:5432/ai_sentinel
# AI_SENTINEL_REDIS_URL=redis://redis:6379

# Telemetry
AI_SENTINEL_TELEMETRY_LEVEL=standard
AI_SENTINEL_TELEMETRY_BACKEND=stdout
AI_SENTINEL_TELEMETRY_PII_REDACT=true

# Feed
AI_SENTINEL_FEED_INTERVAL_SECS=3600
# AI_SENTINEL_CROWDSEC_API_KEY=
# AI_SENTINEL_NVD_API_KEY=
# AI_SENTINEL_CUSTOM_FEED_PATH=

# Rate limits
AI_SENTINEL_RATE_MAX_ACTIONS_PER_HOUR=1000
AI_SENTINEL_RATE_MAX_COST_PER_DAY=100.0
AI_SENTINEL_RATE_MAX_TOKENS_PER_REQUEST=100000

# PII
AI_SENTINEL_PRESIDIO_URL=http://presidio:3000

# DB password for docker-compose postgres service
# SECURITY: Change this before any deployment. Never use sentinel_dev in production.
AI_SENTINEL_DB_PASSWORD=<CHANGE_ME_BEFORE_DEPLOY>
