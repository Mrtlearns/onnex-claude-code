# AI-Sentinel — Environment Variables
# Copy to /opt/ai-sentinel/.env and fill in real values before deploying.
# NEVER commit the real .env file.

# ── Auth ────────────────────────────────────────────────────────────────────
# Admin API token — protects /admin/estop, /admin/feed/refresh, /admin/audit
# Generate: openssl rand -hex 32
AI_SENTINEL_ADMIN_TOKEN=<generate-with-openssl-rand-hex-32>

# API keys (SHA-256 hashes, comma-separated) — used by L2 auth layer
# To add a key: echo -n "sk-your-key" | sha256sum
AI_SENTINEL_API_KEYS=<sha256-of-api-key-1>,<sha256-of-api-key-2>

# JWT secret for bearer token auth (optional — use API keys OR JWT, not both)
# Generate: openssl rand -hex 32
AI_SENTINEL_JWT_SECRET=<generate-with-openssl-rand-hex-32>

# Trust chain HMAC secret — shared with agent-to-agent callers
AI_SENTINEL_TRUST_SECRET=<generate-with-openssl-rand-hex-32>

# ── Database ────────────────────────────────────────────────────────────────
# SECURITY: Never use sentinel_dev in production.
# Generate: openssl rand -base64 18 | tr -d '=+/'
AI_SENTINEL_DB_PASSWORD=<generate-with-openssl-rand>
AI_SENTINEL_DB_URL=postgres://ai_sentinel:<password>@postgres:5432/ai_sentinel

# ── TLS / Gateway ───────────────────────────────────────────────────────────
# Path to Onnex intermediate CA cert + key (mounted read-only in container)
ONNEX_CERT_DIR=/opt/ai-sentinel/certs

# ── Logging ─────────────────────────────────────────────────────────────────
RUST_LOG=info

# ── Testing Mode (Phase 6) ──────────────────────────────────────────────────
# Only used when the binary is compiled with the `testmode` cargo feature. In
# production distributions these are ignored.
AI_SENTINEL_UPSTREAM_URL=https://openrouter.ai/api
AI_SENTINEL_UPSTREAM_API_KEY=<openrouter-api-key>
AI_SENTINEL_UPSTREAM_MODEL=google/gemini-flash-1.5-8b
