# AI-Sentinel Gateway — Runtime-only Dockerfile
# Binary is pre-built on the host with the installed Rust toolchain.
# Build: cargo build --release --bin ai-sentinel-proxy
# Then:  docker build -f Dockerfile.gateway -t ai-sentinel-proxy:latest .
#
# Requires ubuntu:24.04 (GLIBC 2.39) — binary built on Ubuntu 24.04 links
# against GLIBC 2.38+; debian:bookworm-slim only ships GLIBC 2.36.

FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Run as uid 65534 (nobody) — ubuntu:24.04 has nobody at uid 65534
RUN id nobody 2>/dev/null || useradd -u 65534 -M -s /bin/false nobody

WORKDIR /app

COPY target/release/ai-sentinel-proxy /app/ai-sentinel-proxy
RUN chmod +x /app/ai-sentinel-proxy

USER 65534

EXPOSE 8080

ENV RUST_LOG=info
ENV CONFIG_PATH=/config/gateway.toml

ENTRYPOINT ["/app/ai-sentinel-proxy"]
