# AI-Sentinel Gateway — Multi-stage Dockerfile
# Builds the ai-sentinel-proxy binary, runs as uid 65534 (nobody)

# ── Build stage ───────────────────────────────────────────────────────────────
FROM rust:1.78-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /build

# Cache dependency compilation — copy manifests first
COPY Cargo.toml Cargo.lock ./
COPY crates/ai-sentinel-core/Cargo.toml          crates/ai-sentinel-core/
COPY crates/ai-sentinel-layers/Cargo.toml        crates/ai-sentinel-layers/
COPY crates/ai-sentinel-feed/Cargo.toml          crates/ai-sentinel-feed/
COPY crates/ai-sentinel-store/Cargo.toml         crates/ai-sentinel-store/
COPY crates/ai-sentinel-api/Cargo.toml           crates/ai-sentinel-api/
COPY crates/ai-sentinel-classifier/Cargo.toml    crates/ai-sentinel-classifier/
COPY crates/ai-sentinel-proxy/Cargo.toml         crates/ai-sentinel-proxy/

# Stub lib.rs/main.rs for each crate so cargo can resolve deps
RUN for crate in ai-sentinel-core ai-sentinel-layers ai-sentinel-feed ai-sentinel-store ai-sentinel-classifier; do \
      mkdir -p crates/$crate/src && echo "// stub" > crates/$crate/src/lib.rs; \
    done && \
    for crate in ai-sentinel-api ai-sentinel-proxy; do \
      mkdir -p crates/$crate/src && echo "fn main() {}" > crates/$crate/src/main.rs; \
    done

RUN cargo build --release --bin ai-sentinel-proxy 2>/dev/null || true

# Now copy real source and build for real
COPY crates/ crates/
# Touch to force rebuild
RUN find crates -name "*.rs" | xargs touch
RUN cargo build --release --bin ai-sentinel-proxy

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM alpine:3.19 AS runtime

RUN apk add --no-cache ca-certificates

# Run as nobody (uid 65534)
RUN addgroup -g 65534 nobody 2>/dev/null || true && \
    adduser -u 65534 -G nobody -s /bin/sh -D nobody 2>/dev/null || true

WORKDIR /app

COPY --from=builder /build/target/release/ai-sentinel-proxy /app/ai-sentinel-proxy

# Config is mounted at runtime — only the binary is baked in
USER 65534

EXPOSE 8080

ENV RUST_LOG=info
ENV CONFIG_PATH=/config/gateway.toml

ENTRYPOINT ["/app/ai-sentinel-proxy"]
