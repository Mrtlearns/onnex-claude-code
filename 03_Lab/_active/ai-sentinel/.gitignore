__pycache__/
*.pyc
.env
*.local
scripts/node_modules/
scripts/package-lock.json

# Deploy config — may contain credentials; use env vars instead
scripts/_config.py

# The Leptos dashboard's dist/ IS committed (axum include_bytes! embeds it at compile
