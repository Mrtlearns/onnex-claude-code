# ============================================================
# Supabase Frontend Configuration (Vite — exposed to browser)
# ============================================================
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."

# ============================================================
# Supabase Edge Function Runtime Secrets
# Set these in the Supabase dashboard: Settings → Edge Functions
# or via `supabase secrets set KEY=VALUE`
# ============================================================

# Auto-injected by Supabase — no manual setup needed:
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_DB_URL

# Required for AI calls (chat completions, entity/relation extraction).
# Obtain from Lovable workspace.
# LOVABLE_API_KEY="lvbl_..."

# Required for real embeddings (Google text-embedding-004, 768-dim).
# Obtain from Google AI Studio: https://aistudio.google.com/apikey
# GOOGLE_API_KEY="AIza..."

# ============================================================
# Notes for self-hosted Supabase migration
# ============================================================
# When migrating to self-hosted Supabase:
# 1. SUPABASE_URL → your self-hosted Supabase API URL
# 2. SUPABASE_ANON_KEY → generate via `supabase gen keys`
# 3. SUPABASE_SERVICE_ROLE_KEY → generate via `supabase gen keys`
# 4. SUPABASE_DB_URL → postgresql://postgres:password@host:5432/postgres
# 5. LOVABLE_API_KEY → still needed for AI gateway calls
# 6. Update VITE_* vars to point to your self-hosted instance
