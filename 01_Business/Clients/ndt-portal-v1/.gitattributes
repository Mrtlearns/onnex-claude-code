# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly mark binary files to avoid corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.gz binary
