    },
    {
      "parameters": {
        "jsCode": "// Validate required fields before sending the reply.\n// Webhook wraps POST body under .body — unwrap first.\nconst raw = $input.first().json;\nconst item = raw.body ?? raw;\nconst to      = item.to      ?? '';\nconst subject = item.subject ?? '';\nconst body    = item.body    ?? '';\n\nif (!to || !subject || !body) {\n  throw new Error(`Missing required field(s): to=${to || 'MISSING'}, subject=${subject || 'MISSING'}, body=${body ? 'ok' : 'MISSING'}`);\n}\n\nreturn [{\n  json: {\n    to,\n    subject: subject.startsWith('Re:') ? subject : `Re: ${subject}`,\n    body,\n    emailQuoteId: item.emailQuoteId ?? null,\n    checkCode:    item.checkCode    ?? null,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "id": "b0000001-0000-0000-0000-000000000002",
      "name": "Validate & Prepare"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [480, 0],
      "id": "b0000001-0000-0000-0000-000000000003",
