# Public domain for the NDT portal — change this to rename the domain everywhere
PORTAL_DOMAIN=ndt-v1.on-nex.us

# Required secrets (never committed)
PIPELINE_VAULT_KEY=<64-char-hex>
ANTHROPIC_API_KEY=<your-key>

# ============================================================================
# Authentication (Authentik OIDC + JWT)
# ============================================================================

# JWT secret for signing tokens (min 32 chars)
# Generate: openssl rand -hex 16
JWT_SECRET=<random-32-char-hex>

# Authentik OIDC secrets
AUTHENTIK_SECRET_KEY=<random-50-char-hex>
AUTHENTIK_DB_PASSWORD=<strong-password>

# Authentik OIDC application credentials (set after Authentik is running)
AUTHENTIK_ISSUER=https://<authentik-host>/application/o/<slug>/
AUTHENTIK_CLIENT_ID=<set-after-authentik-setup>
AUTHENTIK_CLIENT_SECRET=<optional-for-public-client>

# ============================================================================
# Nextcloud (optional — defaults shown)
# ============================================================================

NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=ncadmin_dev_2024
NEXTCLOUD_DB_PASSWORD=nextcloud_dev
NEXTCLOUD_PUBLIC_URL=http://10.10.110.32:8090
